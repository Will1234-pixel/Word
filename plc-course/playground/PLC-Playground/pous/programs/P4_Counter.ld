(* Counting bottles. Toggle BottleSensor TRUE/FALSE five times: Count goes 1..5 and BoxFull comes on. Pulse ResetPB to start again. *)

PROGRAM P4_Counter
  VAR
    BottleSensor : BOOL; (* Photo-eye: TRUE while a bottle passes *)
    ResetPB : BOOL; (* Reset push-button *)
    BottleCounter : CTU; (* Up-counter instance *)
    Count : INT; (* Bottles counted *)
    BoxFull : BOOL; (* TRUE when 5 bottles have been counted *)
  END_VAR


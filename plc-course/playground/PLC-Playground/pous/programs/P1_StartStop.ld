(* Start/stop with a seal-in. Click StartPB > Force True, then Force False: Motor stays on. Click StopPB_NC > Force False to stop. *)

PROGRAM P1_StartStop
  VAR
    StartPB : BOOL; (* Start push-button, NO: TRUE while pressed *)
    StopPB_NC : BOOL := TRUE; (* Stop push-button, NC: TRUE while NOT pressed (a healthy stop circuit) *)
    Motor : BOOL; (* Motor contactor *)
    RunLamp : BOOL; (* Green running lamp *)
  END_VAR


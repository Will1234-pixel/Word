(* A flashing beacon made from two timers. It runs by itself as soon as the simulator starts. Force Enable FALSE to stop it. *)

PROGRAM P3_Flasher
  VAR
    Enable : BOOL := TRUE; (* Beacon enabled *)
    OnTimer : TON; (* Times the lit half of the cycle *)
    OffTimer : TON; (* Times the dark half of the cycle *)
    OnDone : BOOL; (* Lit half finished *)
    OffDone : BOOL; (* Dark half finished *)
    Beacon : BOOL; (* Flashing beacon: 0.5 s on, 0.5 s off *)
  END_VAR


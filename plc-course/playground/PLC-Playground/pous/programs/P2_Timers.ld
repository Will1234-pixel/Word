(* Timers. Hold DelayPB TRUE for 3 s and DelayLamp lights (watch DelayET count). Turn FanSwitch TRUE then FALSE: Fan runs on for 5 s. *)

PROGRAM P2_Timers
  VAR
    DelayPB : BOOL; (* Push-button that must be held for 3 s *)
    DelayLamp : BOOL; (* Lights after DelayPB has been held for 3 s *)
    DelayTimer : TON; (* On-delay timer instance *)
    DelayET : TIME; (* Elapsed time of DelayTimer *)
    FanSwitch : BOOL; (* Fan on/off switch *)
    Fan : BOOL; (* Fan motor: keeps running 5 s after FanSwitch goes off *)
    RunOnTimer : TOF; (* Off-delay timer instance *)
    RunOnET : TIME; (* Elapsed time of RunOnTimer *)
  END_VAR


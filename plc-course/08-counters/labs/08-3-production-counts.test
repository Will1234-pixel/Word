expect TotalCount 20
expect YieldPct ~ 90.0 0.01
expect LowYieldLamp TRUE           # 20 packs at 90 %: warn
set ShiftResetPB TRUE
scan
set ShiftResetPB FALSE
scan
expect LowYieldLamp FALSE          # new shift: nothing to judge yet

scenario the low-yield lamp follows MinSample and YieldLimit from the HMI
set MinSample 4
set YieldLimit 80.0
scan
set GoodPE TRUE
scan
set GoodPE FALSE
scan
set GoodPE TRUE
scan
set GoodPE FALSE
scan
set RejectPE TRUE
scan
set RejectPE FALSE
scan
expect YieldPct ~ 66.667 0.01
expect LowYieldLamp FALSE          # 3 packs: below MinSample
set GoodPE TRUE
scan
set GoodPE FALSE
scan
expect YieldPct ~ 75.0 0.01
expect LowYieldLamp TRUE           # 4 packs at 75 %: below 80 %
set YieldLimit 75.0
scan
expect LowYieldLamp FALSE          # exactly at the limit is not below it
set YieldLimit 80.0
scan
expect LowYieldLamp TRUE
set GoodPE TRUE
scan
set GoodPE FALSE
scan
set GoodPE TRUE
scan
set GoodPE FALSE
scan
expect YieldPct ~ 83.333 0.01
expect LowYieldLamp FALSE          # 6 packs at 83.3 %: good again
set YieldLimit 90.0                # tighten the limit
scan
expect LowYieldLamp TRUE

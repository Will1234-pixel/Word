scenario illegal commands in Aborting, Aborted, Stopping and Clearing are refused
set SafetyOK TRUE
scan
set CntrlCmd 8
set CmdChangeRequest TRUE
scan
expect StateCurrent 8            # Aborting
set CntrlCmd 3                   # Stop in Aborting
set CmdChangeRequest TRUE
scan
expect StateCurrent 8
expect CmdRejected TRUE
set CntrlCmd 9                   # Clear in Aborting (not aborted yet)
set CmdChangeRequest TRUE
scan
expect StateCurrent 8
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 9            # Aborted
set CntrlCmd 1                   # Reset in Aborted: must Clear first
set CmdChangeRequest TRUE
scan
expect StateCurrent 9
expect CmdRejected TRUE
set CntrlCmd 3                   # Stop in Aborted
set CmdChangeRequest TRUE
scan
expect StateCurrent 9
set CntrlCmd 8                   # Abort in Aborted
set CmdChangeRequest TRUE
scan
expect StateCurrent 9
set CntrlCmd 2                   # Start in Aborted
set CmdChangeRequest TRUE
scan
expect StateCurrent 9
expect CmdRejected TRUE
set CntrlCmd 9
set CmdChangeRequest TRUE
scan
expect StateCurrent 1            # Clearing
set CntrlCmd 3                   # Stop in Clearing
set CmdChangeRequest TRUE
scan
expect StateCurrent 1
expect CmdRejected TRUE
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set CntrlCmd 3
set CmdChangeRequest TRUE
scan
expect StateCurrent 7            # Stopping
set CntrlCmd 3                   # Stop in Stopping
set CmdChangeRequest TRUE
scan
expect StateCurrent 7
expect CmdRejected TRUE
set CntrlCmd 1                   # Reset in Stopping
set CmdChangeRequest TRUE
scan
expect StateCurrent 7

scenario unknown command codes are refused
set SafetyOK TRUE
scan
set CntrlCmd 0                   # 0 = undefined
set CmdChangeRequest TRUE
scan
expect StateCurrent 2
expect CmdRejected TRUE
expect CmdChangeRequest FALSE
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
expect CmdRejected FALSE
set CntrlCmd 42
set CmdChangeRequest TRUE
scan
expect StateCurrent 15
expect CmdRejected TRUE
set CntrlCmd -1
set CmdChangeRequest TRUE
scan
expect StateCurrent 15
expect CmdRejected TRUE
expect CmdChangeRequest FALSE

scenario loss of SafetyOK aborts from Execute and blocks Clear until it is healthy
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6
set SafetyOK FALSE               # e-stop pressed
scan
expect StateCurrent 8            # Aborting at once, no command needed
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 9            # Aborted
wait 500ms
expect StateCurrent 9
expect CmdRejected FALSE         # the machine's own abort is not a refused request
set CntrlCmd 9                   # Clear while the e-stop is still pressed
set CmdChangeRequest TRUE
scan
expect StateCurrent 9
expect CmdRejected TRUE
expect CmdChangeRequest FALSE    # consumed, not left waiting
set SafetyOK TRUE                # e-stop released and safety relay reset
wait 1s
expect StateCurrent 9            # still Aborted: the old request did not come back
set CntrlCmd 9
set CmdChangeRequest TRUE
scan
expect StateCurrent 1            # Clearing
expect CmdRejected FALSE
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 2
wait 1s
expect StateCurrent 2            # no restart

scenario loss of SafetyOK aborts from Stopped, Idle and Clearing
set SafetyOK FALSE               # safety not healthy at power-up
scan
expect StateCurrent 8
set StateComplete TRUE
scan
set StateComplete FALSE
set SafetyOK TRUE
set CntrlCmd 9
set CmdChangeRequest TRUE
scan
expect StateCurrent 1            # Clearing
set SafetyOK FALSE
scan
expect StateCurrent 8            # Clearing -> Aborting
set StateComplete TRUE
scan
set StateComplete FALSE
set SafetyOK TRUE
set CntrlCmd 9
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 4            # Idle
set SafetyOK FALSE
scan
expect StateCurrent 8            # Idle -> Aborting
set SafetyOK TRUE
scan
expect StateCurrent 8            # safety back: still Aborting, then Aborted on SC

scenario Starved suspends the machine in Execute, and it unsuspends when product returns
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6
set Starved TRUE                 # infeed runs out of cases
scan
scan
expect StateCurrent 13           # Suspending, without any command
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 5            # Suspended
wait 1s
expect StateCurrent 5            # still starved: stays suspended
set Starved FALSE                # product arrives again
scan
scan
expect StateCurrent 14           # Unsuspending
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6            # back in Execute
wait 500ms
expect StateCurrent 6

scenario Blocked suspends too, and the machine unsuspends only when both signals clear
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set Blocked TRUE                 # outfeed backed up
scan
scan
expect StateCurrent 13
set StateComplete TRUE
scan
set StateComplete FALSE
set Starved TRUE                 # and now the infeed is empty as well
set Blocked FALSE
wait 500ms
expect StateCurrent 5            # still suspended: starved
set Starved FALSE
scan
scan
expect StateCurrent 14

scenario Starved or Blocked outside Execute does not change the state
set SafetyOK TRUE
set Starved TRUE
set Blocked TRUE
scan
wait 300ms
expect StateCurrent 2            # Stopped
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
wait 300ms
expect StateCurrent 4            # Idle: nothing to suspend
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
wait 300ms
expect StateCurrent 3            # Starting waits for SC, not for product

scenario Stop wins over the automatic unsuspend logic
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set Starved TRUE
scan
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 5            # Suspended
set CntrlCmd 3                   # operator stops the line while it is starved
set CmdChangeRequest TRUE
scan
expect StateCurrent 7
set Starved FALSE                # product returns while stopping
wait 300ms
expect StateCurrent 7            # still Stopping: no unsuspend outside Suspended
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 2

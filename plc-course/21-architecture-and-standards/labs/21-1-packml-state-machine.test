# Lab 21-1 acceptance tests: PackML base state machine for a case packer.
#
# The line controller is simulated by writing CntrlCmd and then setting
# CmdChangeRequest TRUE, exactly as a remote system writes PackTags. The
# machine's own state logic is simulated by pulsing StateComplete (SC) for
# one scan. The tests check that:
#   - the machine powers up in Stopped and never moves without a command or SC,
#   - every standard path works: Reset/Start/Complete, Hold/Unhold,
#     Suspend/Unsuspend, Stop, Abort/Clear, each acting state waiting for SC,
#   - Stop and Abort are accepted exactly where the model says,
#   - illegal commands and unknown codes are refused, flagged with
#     CmdRejected, and leave the state unchanged,
#   - every request is consumed (CmdChangeRequest cleared) on the scan it is seen,
#   - SC means nothing in a wait state,
#   - loss of SafetyOK aborts from any state and blocks Clear,
#   - Starved/Blocked suspend the machine in Execute and it unsuspends by
#     itself when both clear.
# Only interface tags are used, so any correct design passes.
#
# StateCurrent codes (PackTags):
#   1 Clearing  2 Stopped  3 Starting  4 Idle  5 Suspended  6 Execute
#   7 Stopping  8 Aborting  9 Aborted  10 Holding  11 Held  12 Unholding
#   13 Suspending  14 Unsuspending  15 Resetting  16 Completing  17 Complete
# CntrlCmd codes:
#   1 Reset  2 Start  3 Stop  4 Hold  5 Unhold  6 Suspend  7 Unsuspend
#   8 Abort  9 Clear

scenario power-up in Stopped, and nothing moves on its own
set SafetyOK TRUE                # healthy safety circuit
scan
expect StateCurrent 2            # Stopped
expect CmdRejected FALSE
wait 1s
expect StateCurrent 2

scenario the normal production cycle, one request and one SC at a time
set SafetyOK TRUE
scan
set CntrlCmd 1                   # Reset
set CmdChangeRequest TRUE
scan
expect StateCurrent 15           # Resetting
expect CmdChangeRequest FALSE    # request consumed
expect CmdRejected FALSE
wait 1s
expect StateCurrent 15           # an acting state waits for its SC
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 4            # Idle
wait 1s
expect StateCurrent 4            # a wait state waits for a command
set CntrlCmd 2                   # Start
set CmdChangeRequest TRUE
scan
expect StateCurrent 3            # Starting
expect CmdChangeRequest FALSE
wait 500ms
expect StateCurrent 3
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6            # Execute
wait 1s
expect StateCurrent 6            # Execute also waits: for SC, Hold, Suspend, Stop or Abort
set StateComplete TRUE           # the order quantity has been packed
scan
set StateComplete FALSE
expect StateCurrent 16           # Completing
wait 500ms
expect StateCurrent 16
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 17           # Complete
wait 500ms
expect StateCurrent 17
set CntrlCmd 1                   # Reset from Complete
set CmdChangeRequest TRUE
scan
expect StateCurrent 15           # Resetting (never straight to Idle)
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 4            # Idle, ready for the next order

scenario a command code without a change request does nothing
set SafetyOK TRUE
scan
set CntrlCmd 1                   # Reset written, but no request
wait 500ms
expect StateCurrent 2
expect CmdRejected FALSE
set CmdChangeRequest TRUE        # now the request arrives
scan
expect StateCurrent 15
expect CmdChangeRequest FALSE
wait 500ms
expect StateCurrent 15           # the same request is not executed twice

scenario SC in a wait state means nothing
set SafetyOK TRUE
scan
set StateComplete TRUE           # SC held TRUE in Stopped
wait 300ms
expect StateCurrent 2
set StateComplete FALSE
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 4            # Idle
set StateComplete TRUE           # SC held TRUE in Idle: must not start the machine
wait 300ms
expect StateCurrent 4
set StateComplete FALSE
scan
expect StateCurrent 4

scenario Hold and Unhold go through Holding, Held and Unholding
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6            # Execute
set CntrlCmd 4                   # Hold
set CmdChangeRequest TRUE
scan
expect StateCurrent 10           # Holding
expect CmdChangeRequest FALSE
wait 500ms
expect StateCurrent 10
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 11           # Held
set StateComplete TRUE           # SC in Held (a wait state) is ignored
wait 300ms
expect StateCurrent 11
set StateComplete FALSE
set CntrlCmd 5                   # Unhold
set CmdChangeRequest TRUE
scan
expect StateCurrent 12           # Unholding, not straight back to Execute
wait 300ms
expect StateCurrent 12
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6            # Execute again

scenario Suspend and Unsuspend commands go through Suspending, Suspended and Unsuspending
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 6                   # Suspend
set CmdChangeRequest TRUE
scan
expect StateCurrent 13           # Suspending
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 5            # Suspended
wait 1s
expect StateCurrent 5            # suspended by command: waits for Unsuspend
set StateComplete TRUE           # ignored in a wait state
wait 300ms
expect StateCurrent 5
set StateComplete FALSE
set CntrlCmd 7                   # Unsuspend
set CmdChangeRequest TRUE
scan
expect StateCurrent 14           # Unsuspending
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 6            # Execute

scenario Stop from Execute goes through Stopping to Stopped, then Reset works again
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE

scenario illegal commands in Stopped and Idle are refused and flagged
set SafetyOK TRUE
scan
set CntrlCmd 2                   # Start in Stopped: must Reset first
set CmdChangeRequest TRUE
scan
expect StateCurrent 2
expect CmdRejected TRUE
expect CmdChangeRequest FALSE    # a refused request is consumed too
set CntrlCmd 3                   # Stop in Stopped
set CmdChangeRequest TRUE
scan
expect StateCurrent 2
expect CmdRejected TRUE
set CntrlCmd 9                   # Clear in Stopped
set CmdChangeRequest TRUE
scan
expect StateCurrent 2
set CntrlCmd 5                   # Unhold in Stopped
set CmdChangeRequest TRUE
scan
expect StateCurrent 2
set CntrlCmd 1                   # a valid command clears the flag
set CmdChangeRequest TRUE
scan
expect StateCurrent 15
expect CmdRejected FALSE
set CntrlCmd 1                   # Reset in Resetting
set CmdChangeRequest TRUE
scan
expect StateCurrent 15
expect CmdRejected TRUE
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 4            # Idle
set CntrlCmd 1                   # Reset in Idle
set CmdChangeRequest TRUE
scan
expect StateCurrent 4
expect CmdRejected TRUE
set CntrlCmd 4                   # Hold in Idle
set CmdChangeRequest TRUE
scan
expect StateCurrent 4
set CntrlCmd 6                   # Suspend in Idle
set CmdChangeRequest TRUE
scan
expect StateCurrent 4
set CntrlCmd 7                   # Unsuspend in Idle
set CmdChangeRequest TRUE
scan
expect StateCurrent 4
set CntrlCmd 9                   # Clear in Idle
set CmdChangeRequest TRUE
scan
expect StateCurrent 4
expect CmdRejected TRUE
expect CmdChangeRequest FALSE


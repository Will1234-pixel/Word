scenario Abort and Clear: Aborting, Aborted, Clearing, Stopped
set SafetyOK TRUE
scan
set CntrlCmd 1
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 2
set CmdChangeRequest TRUE
scan
set StateComplete TRUE
scan
set StateComplete FALSE
set CntrlCmd 8                   # Abort from Execute
set CmdChangeRequest TRUE
scan
expect StateCurrent 8            # Aborting
expect CmdChangeRequest FALSE
wait 500ms
expect StateCurrent 8
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 9            # Aborted
wait 1s
expect StateCurrent 9            # stays aborted until someone clears it
set CntrlCmd 9                   # Clear
set CmdChangeRequest TRUE
scan
expect StateCurrent 1            # Clearing
wait 500ms
expect StateCurrent 1
set StateComplete TRUE
scan
set StateComplete FALSE
expect StateCurrent 2            # Stopped: Clear never restarts the machine
wait 1s
expect StateCurrent 2


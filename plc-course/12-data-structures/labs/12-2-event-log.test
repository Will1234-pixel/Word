set NewCode 106
set LogReq TRUE
scan
set NewCode 107
set LogReq TRUE
scan
set NewCode 108
set LogReq TRUE
scan
set NewCode 109
set LogReq TRUE
scan
set NewCode 110
set LogReq TRUE
scan
set NewCode 111
set LogReq TRUE
scan
set NewCode 112
set LogReq TRUE
scan
set NewCode 113
set LogReq TRUE
scan
set NewCode 114
set LogReq TRUE
scan
set NewCode 115
set LogReq TRUE
scan
set NewCode 116
set LogReq TRUE
scan
set NewCode 117
set LogReq TRUE
scan
set NewCode 118
set LogReq TRUE
scan
set NewCode 119
set LogReq TRUE
scan
set NewCode 120
set LogReq TRUE
scan
set NewCode 121
set LogReq TRUE
scan
set NewCode 122
set LogReq TRUE
scan
set NewCode 123
set LogReq TRUE
scan
expect Count 10
expect Total 23
expect Newest 2
expect EventLog[2].Code 123
expect EventLog[3].Code 114
expect EventLog[0].Code 121
expect EventLog[9].Code 120
set ViewAge 3                      # slot 2 - 3 wraps to slot 9
scan 2
expect View.Code 120
set ViewAge 9
scan 2
expect View.Code 114

scenario clear empties every slot, and logging restarts at slot 0
set NewCode 501
set LogReq TRUE
scan
set NewCode 502
set LogReq TRUE
scan
set NewCode 503
set LogReq TRUE
scan
set NewCode 504
set LogReq TRUE
scan
set NewCode 505
set LogReq TRUE
scan
set NewCode 506
set LogReq TRUE
scan
set NewCode 507
set LogReq TRUE
scan
set NewCode 508
set LogReq TRUE
scan
set NewCode 509
set LogReq TRUE
scan
set NewCode 510
set LogReq TRUE
scan
set NewCode 511
set LogReq TRUE
scan
set NewCode 512
set LogReq TRUE
scan
expect Count 10
set ClearCmd TRUE
scan 2
expect ClearCmd FALSE              # the logger clears the command
expect Count 0
expect Total 0
expect Newest 0
expect ViewValid FALSE
expect EventLog[0].Code 0
expect EventLog[0].Stamp 0
expect EventLog[1].Code 0
expect EventLog[5].Code 0
expect EventLog[9].Code 0
expect EventLog[9].Stamp 0
set NewCode 601
set LogReq TRUE
scan
expect Count 1
expect Total 1
expect Newest 0
expect EventLog[0].Code 601
expect EventLog[1].Code 0
set NewCode 602
set LogReq TRUE
scan
expect Newest 1
expect EventLog[1].Code 602
expect EventLog[2].Code 0
set ViewAge 1
scan 2
expect View.Code 601
set ViewAge 2
scan 2
expect ViewValid FALSE

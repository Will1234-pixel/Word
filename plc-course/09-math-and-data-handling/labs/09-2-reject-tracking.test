scenario while reset is held, camera results and pulses are ignored and the gate stays off
set InspectFail TRUE          # part A is bad
scan 2
set InspectFail FALSE
scan 2
expect TrackWord 16#0001
set ResetPB TRUE              # reset pressed and held
scan 2
expect TrackWord 16#0000
set InspectFail TRUE          # a camera result while reset is still held
scan 2
set InspectFail FALSE
scan 2
expect TrackWord 16#0000
expect RejectGate FALSE
set EncoderPulse TRUE         # the belt moves while reset is still held
scan 2
set EncoderPulse FALSE
scan 2
expect TrackWord 16#0000
set ResetPB FALSE
scan 2
expect TrackWord 16#0000

scan 2
expect RejectGate TRUE
expect TrackWord 16#8000
expect RejectCount 1
set EncoderPulse TRUE         # pulse 16
scan 2
set EncoderPulse FALSE
scan 2
expect RejectGate FALSE
expect TrackWord 16#0000


until ConveyorRun TRUE within 3500ms
# a part sliding past the lane-full eye blocks it for a moment: not full
set LaneA_FullPE TRUE
wait 800ms
expect HMI.Sts.LaneAFull FALSE
expect AmberLamp FALSE
set LaneA_FullPE FALSE
wait 1500ms
# the lane backs up to the eye
set LaneA_FullPE TRUE
wait 800ms
expect HMI.Sts.LaneAFull FALSE   # 0.8 s
wait 400ms
expect HMI.Sts.LaneAFull TRUE   # 1.2 s
expect AmberLamp TRUE
expect HMI.Sts.LaneBFull FALSE
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
# lane A is full: no push
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1500
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1600
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1700
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1800
wait 200ms
set EncCount 1900
wait 200ms
set EncCount 2000
wait 200ms
expect PusherB_Sol FALSE
set EncCount 2100
wait 200ms
expect PusherB_Sol FALSE
set EncCount 2200
wait 200ms
set EncCount 2300
wait 200ms
set EncCount 2400
wait 200ms
set EncCount 2500
wait 200ms
set EncCount 2550
wait 100ms
set RejectPE TRUE   # the part drops past the reject chute eye
wait 100ms
set RejectPE FALSE
scan
until HMI.Sts.CountReject 1 within 50ms
expect HMI.Sts.CountMetal 1
expect HMI.Sts.CountLaneA 0
until HMI.Sts.PartsInTransit 0 within 50ms
expect ConveyorRun TRUE   # a full lane is a warning, not a stop
expect HMI.Sts.State 3
expect HMI.Alm.EStop FALSE
expect HMI.Alm.MotorOverload FALSE
expect HMI.Alm.EntryJam FALSE
expect HMI.Alm.Jam FALSE
expect HMI.Alm.PusherA FALSE
expect HMI.Alm.PusherB FALSE
expect HMI.Alm.TrackOverflow FALSE
expect RedLamp FALSE
# the lane is emptied
set LaneA_FullPE FALSE
until HMI.Sts.LaneAFull FALSE within 1500ms
expect AmberLamp FALSE
set EncCount 2650
wait 200ms
set EncCount 2750
wait 200ms
set EncCount 2850
wait 200ms
set EncCount 2900
wait 100ms
# P2 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 2950
wait 100ms
set EncCount 3000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 3000
scan
set MetalPX FALSE
set EncCount 3100
wait 200ms
set EncCount 3200
wait 200ms
set EncCount 3300
wait 200ms
set EncCount 3400
wait 200ms
set EncCount 3490
wait 180ms
wait 50ms
expect PusherA_Sol FALSE   # 10 mm short of the gate: not yet
set EncCount 3500
until PusherA_Sol TRUE within 50ms   # at the gate: push
# sorting into lane A resumes
set PusherA_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherA_Sol TRUE   # still energised until the extended switch is made
set PusherA_ExtLS TRUE   # fully extended
until PusherA_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherA_ExtLS FALSE
wait 100ms
set PusherA_RetLS TRUE   # back home
wait 100ms
set LaneA_PE TRUE   # the part slides past the lane A delivery eye
wait 100ms
set LaneA_PE FALSE
scan
until HMI.Sts.CountLaneA 1 within 50ms
expect HMI.Sts.CountReject 1


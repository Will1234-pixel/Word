scenario M5 entry jam: entry eye blocked for 2 s while running (not while stopped)
# Requirements: FS-13, FS-25, FS-30, FS-31
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
wait 100ms
set EntryPE TRUE   # a part sits at the entry while the cell is stopped
wait 5s
expect HMI.Alm.EntryJam FALSE   # stopped: not a jam
expect HMI.Sts.State 1
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms   # the warning time does not count
wait 1800ms
expect ConveyorRun TRUE   # 1.8 s of running
expect HMI.Alm.EntryJam FALSE
wait 400ms
expect HMI.Alm.EntryJam TRUE   # 2.2 s: jam
expect ConveyorRun FALSE
expect HMI.Sts.State 4
set ResetPB TRUE   # reset with the part still there
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.EntryJam TRUE   # refused: the eye is still blocked
set EntryPE FALSE   # operator removes the part
wait 200ms
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.EntryJam FALSE
expect HMI.Sts.State 1
expect ConveyorRun FALSE
expect HMI.Sts.CountMetal 0   # the removed part was never registered
expect HMI.Sts.CountPlastic 0

scenario M5 jam: a metal part pushed but never seen in lane A trips the cell 3 s after registration
# Requirements: FS-11, FS-26, FS-28, FS-31
# The part registers at t0. Pusher A fires 1.0 s later, but the part never
# reaches the lane A delivery eye (stuck in the chute).
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1490
wait 180ms
set EncCount 1507
until PusherA_Sol TRUE within 50ms   # the count jumps past the gate between scans: push
set PusherA_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherA_Sol TRUE   # still energised until the extended switch is made
set PusherA_ExtLS TRUE   # fully extended
until PusherA_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherA_ExtLS FALSE
wait 100ms
set PusherA_RetLS TRUE   # back home
# the belt keeps running
set EncCount 1607
wait 200ms
set EncCount 1707
wait 200ms
set EncCount 1807
wait 200ms
set EncCount 1900
wait 186ms
wait 714ms   # about 2.7 s after registration
expect HMI.Alm.Jam FALSE
expect ConveyorRun TRUE
wait 600ms   # about 3.3 s
expect HMI.Alm.Jam TRUE
expect ConveyorRun FALSE
expect HMI.Sts.State 4
until HMI.Sts.PartsInTransit 0 within 50ms   # a fault stop forgets the tracking
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.Jam FALSE
expect HMI.Sts.State 1
expect ConveyorRun FALSE   # reset never starts the belt


scenario M6 pusher A fails to extend while sorting: the cell stops and needs a reset and a Start
# Requirements: FS-19, FS-28, FS-31
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1490
wait 180ms
set EncCount 1507
until PusherA_Sol TRUE within 50ms   # the count jumps past the gate between scans: push
set PusherA_RetLS FALSE   # the cylinder never reaches its extended switch
wait 800ms
expect PusherA_Sol TRUE
expect ConveyorRun TRUE
expect HMI.Alm.PusherA FALSE
wait 400ms
expect HMI.Alm.PusherA TRUE
expect PusherA_Sol FALSE
expect ConveyorRun FALSE
expect HMI.Sts.State 4
expect HMI.Alm.Unacked TRUE
until HMI.Sts.PartsInTransit 0 within 50ms
set PusherA_RetLS TRUE   # the spring retracts it
wait 200ms
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.PusherA FALSE
expect HMI.Sts.State 1
wait 1s
expect ConveyorRun FALSE   # reset never starts the belt
set StartPB TRUE
scan
set StartPB FALSE
until Horn TRUE within 30ms
until ConveyorRun TRUE within 3500ms

scenario M6 e-stop while running: everything stops at once; release and reset before a new start
# Requirements: FS-11, FS-27, FS-28, FS-30, FS-31
# The part on the belt was tracked. After an e-stop the tracking is forgotten,
# so after the restart it is not pushed and ends up in the reject bin.
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EStop_NC FALSE   # EMERGENCY STOP pressed
until ConveyorRun FALSE within 30ms
expect Horn FALSE
expect PusherA_Sol FALSE
expect PusherB_Sol FALSE
expect HMI.Alm.EStop TRUE
expect HMI.Sts.State 4
until HMI.Sts.PartsInTransit 0 within 50ms
set ResetPB TRUE   # reset while the e-stop is still pressed
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.EStop TRUE   # refused
set EStop_NC TRUE   # e-stop released
wait 1s
expect HMI.Alm.EStop TRUE   # releasing the e-stop does not clear the alarm
expect HMI.Sts.State 4
expect ConveyorRun FALSE
expect HMI.Sts.Ready FALSE
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.EStop FALSE
expect HMI.Sts.State 1
wait 1s
expect ConveyorRun FALSE   # reset alone never starts the belt
set StartPB TRUE
scan
set StartPB FALSE
until Horn TRUE within 30ms
until ConveyorRun TRUE within 3500ms
# the untracked part passes both gates
set EncCount 1400
wait 200ms
set EncCount 1500
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1600
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1700
wait 200ms
set EncCount 1800
wait 200ms
set EncCount 1900
wait 200ms
set EncCount 2000
wait 200ms
expect PusherB_Sol FALSE
set EncCount 2100
wait 200ms
expect PusherB_Sol FALSE
set EncCount 2200
wait 200ms
set EncCount 2300
wait 200ms
set EncCount 2400
wait 200ms
set EncCount 2500
wait 200ms
set EncCount 2550
wait 100ms
set RejectPE TRUE   # the part drops past the reject chute eye
wait 100ms
set RejectPE FALSE
scan
until HMI.Sts.CountReject 1 within 50ms
expect HMI.Sts.CountLaneA 0
expect HMI.Sts.CountMetal 1   # counted when it was classified
wait 6s
expect HMI.Alm.EStop FALSE
expect HMI.Alm.MotorOverload FALSE
expect HMI.Alm.EntryJam FALSE
expect HMI.Alm.Jam FALSE
expect HMI.Alm.PusherA FALSE
expect HMI.Alm.PusherB FALSE
expect HMI.Alm.TrackOverflow FALSE
expect HMI.Sts.State 3

scenario M6 e-stop during the start-up warning silences the horn and nothing starts
# Requirements: FS-28
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
wait 100ms
set StartPB TRUE
scan
set StartPB FALSE
wait 1s
expect Horn TRUE
set EStop_NC FALSE
until Horn FALSE within 30ms
expect HMI.Sts.State 4
wait 200ms
set EStop_NC TRUE
wait 4s
expect ConveyorRun FALSE
expect Horn FALSE
expect HMI.Sts.State 4

scenario M6 e-stop during a pusher stroke releases the solenoid at once
# Requirements: FS-19, FS-28
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1490
wait 180ms
set EncCount 1507
until PusherA_Sol TRUE within 50ms   # the count jumps past the gate between scans: push
set PusherA_RetLS FALSE
wait 50ms
set EStop_NC FALSE
until PusherA_Sol FALSE within 30ms
expect ConveyorRun FALSE
wait 100ms
set PusherA_RetLS TRUE   # the spring returns it home within the timeout
wait 1500ms
expect HMI.Alm.PusherA FALSE   # a pusher that got home in time has no fault
expect HMI.Alm.EStop TRUE

scenario M6 motor overload stops the cell; reset is refused until the overload relay is reset
# Requirements: FS-02, FS-27, FS-30
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
set MotorOL_NC FALSE   # overload relay trips
until ConveyorRun FALSE within 30ms
expect HMI.Alm.MotorOverload TRUE
expect HMI.Sts.State 4
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.MotorOverload TRUE   # refused: relay still tripped
set MotorOL_NC TRUE   # electrician resets the relay
wait 500ms
expect HMI.Alm.MotorOverload TRUE   # latched until reset
expect HMI.Sts.State 4
set HMI.Cmd.Reset TRUE   # reset from the HMI this time
scan
expect HMI.Cmd.Reset FALSE
until HMI.Alm.MotorOverload FALSE within 50ms
until HMI.Sts.State 1 within 50ms
wait 1s
expect ConveyorRun FALSE

scenario M6 alarm acknowledgement: red flashes until acknowledged, steady until reset
# Requirements: FS-29, FS-30, FS-32
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
wait 100ms
expect RedLamp FALSE
set MotorOL_NC FALSE
wait 100ms
expect HMI.Alm.MotorOverload TRUE
expect HMI.Alm.Unacked TRUE
# flashing: the lamp must change state at least every 1.1 s
until RedLamp TRUE within 1100ms
until RedLamp FALSE within 1100ms
until RedLamp TRUE within 1100ms
set MotorOL_NC TRUE   # relay reset: the cause has gone, the alarm stays until Reset
wait 200ms
expect HMI.Alm.MotorOverload TRUE
expect HMI.Alm.Unacked TRUE
set HMI.Cmd.Ack TRUE
scan
expect HMI.Cmd.Ack FALSE
wait 50ms
expect HMI.Alm.Unacked FALSE
# acknowledged but still active: steady
expect RedLamp TRUE
wait 300ms
expect RedLamp TRUE
wait 300ms
expect RedLamp TRUE
wait 300ms
expect RedLamp TRUE
wait 300ms
expect RedLamp TRUE
expect HMI.Alm.MotorOverload TRUE   # Ack does not reset
expect HMI.Sts.State 4
# a second alarm is new, so it flashes again
set EStop_NC FALSE
wait 100ms
expect HMI.Alm.Unacked TRUE
until RedLamp TRUE within 1100ms
until RedLamp FALSE within 1100ms
until RedLamp TRUE within 1100ms
set EStop_NC TRUE
wait 200ms
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.EStop FALSE
expect HMI.Alm.MotorOverload FALSE
expect HMI.Alm.Unacked FALSE
expect HMI.Sts.State 1
expect RedLamp FALSE
wait 300ms
expect RedLamp FALSE
wait 300ms
expect RedLamp FALSE
wait 300ms
expect RedLamp FALSE
wait 300ms
expect RedLamp FALSE

scenario M6 Reset acts on the press: a held (or stuck) Reset button does not clear a new fault
# Requirements: FS-30
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
wait 100ms
set ResetPB TRUE   # Reset held down
wait 200ms
set MotorOL_NC FALSE   # overload trips...
wait 200ms
set MotorOL_NC TRUE   # ...and is reset at the relay
wait 1s
expect HMI.Alm.MotorOverload TRUE   # the held button does not reset it
expect HMI.Sts.State 4
set ResetPB FALSE
wait 200ms
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Alm.MotorOverload FALSE
expect HMI.Sts.State 1

scenario M6 a reset never restarts the cell, even with Start held or commanded during the fault
# Requirements: FS-05, FS-31
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
set MotorOL_NC FALSE
until ConveyorRun FALSE within 30ms
set MotorOL_NC TRUE
set StartPB TRUE   # operator holds Start
wait 200ms
set HMI.Cmd.Start TRUE   # and presses Start on the HMI while faulted
scan
expect HMI.Cmd.Start FALSE   # cleared, and forgotten
wait 200ms
set ResetPB TRUE
scan
set ResetPB FALSE
wait 200ms
expect HMI.Sts.State 1
wait 4s
expect Horn FALSE
expect ConveyorRun FALSE
set StartPB FALSE
wait 200ms
set StartPB TRUE   # a fresh press starts the cell
scan
set StartPB FALSE
until Horn TRUE within 30ms
until ConveyorRun TRUE within 3500ms

scenario M7 stop and restart with a part on the belt: tracking kept, jam clock paused
# Requirements: FS-08, FS-26
# 10 s stopped plus a 3 s warning is far longer than the 3 s jam time for
# lane A. Only conveyor running time counts, so there is no jam.
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set StopPB_NC FALSE
until ConveyorRun FALSE within 30ms
set StopPB_NC TRUE
wait 10s
expect HMI.Alm.Jam FALSE
expect HMI.Sts.State 1
expect HMI.Sts.PartsInTransit 1   # still tracked
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
set EncCount 1400
wait 200ms
set EncCount 1490
wait 180ms
wait 50ms
expect PusherA_Sol FALSE   # 10 mm short of the gate: not yet
set EncCount 1500
until PusherA_Sol TRUE within 50ms   # at the gate: push
# pushed at the right place after the restart
set PusherA_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherA_Sol TRUE   # still energised until the extended switch is made
set PusherA_ExtLS TRUE   # fully extended
until PusherA_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherA_ExtLS FALSE
wait 100ms
set PusherA_RetLS TRUE   # back home
wait 100ms
set LaneA_PE TRUE   # the part slides past the lane A delivery eye
wait 100ms
set LaneA_PE FALSE
scan
until HMI.Sts.CountLaneA 1 within 50ms
until HMI.Sts.PartsInTransit 0 within 50ms
wait 3s
expect HMI.Alm.Jam FALSE
expect HMI.Sts.State 3

scenario M7 a normal Stop during a pusher stroke lets the stroke finish
# Requirements: FS-08
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1490
wait 180ms
set EncCount 1507
until PusherA_Sol TRUE within 50ms   # the count jumps past the gate between scans: push
set StopPB_NC FALSE   # Stop pressed mid-stroke
until ConveyorRun FALSE within 30ms
expect PusherA_Sol TRUE   # the stroke is not cut short
set StopPB_NC TRUE
set PusherA_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherA_Sol TRUE   # still energised until the extended switch is made
set PusherA_ExtLS TRUE   # fully extended
until PusherA_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherA_ExtLS FALSE
wait 100ms
set PusherA_RetLS TRUE   # back home
wait 100ms
set LaneA_PE TRUE   # the part slides past the lane A delivery eye
wait 100ms
set LaneA_PE FALSE
scan
until HMI.Sts.CountLaneA 1 within 50ms
until HMI.Sts.PartsInTransit 0 within 50ms
wait 2s
expect HMI.Alm.EStop FALSE
expect HMI.Alm.MotorOverload FALSE
expect HMI.Alm.EntryJam FALSE
expect HMI.Alm.Jam FALSE
expect HMI.Alm.PusherA FALSE
expect HMI.Alm.PusherB FALSE
expect HMI.Alm.TrackOverflow FALSE
expect HMI.Sts.State 1

scenario M7 Manual forgets the tracking; parts are neither pushed nor registered in Manual
# Requirements: FS-09, FS-11, FS-13
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
set MetalPX FALSE
until HMI.Sts.PartsInTransit 1 within 50ms
set ModeAuto FALSE
set ModeManual TRUE   # selector to MAN
wait 100ms
expect ConveyorRun FALSE
expect HMI.Sts.State 5
until HMI.Sts.PartsInTransit 0 within 50ms
set JogPB TRUE   # jog the belt
wait 100ms
set EncCount 1100
wait 200ms
set EncCount 1200
wait 200ms
set EncCount 1300
wait 200ms
set EncCount 1400
wait 200ms
set EncCount 1500
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1600
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1700
wait 200ms
expect PusherA_Sol FALSE
set EncCount 1800
wait 200ms
# P2 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 1850
wait 100ms
set EncCount 1900
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1900
scan
set MetalPX FALSE
wait 100ms
expect HMI.Sts.CountMetal 1   # not registered in Manual
expect HMI.Sts.PartsInTransit 0
set JogPB FALSE
until ConveyorRun FALSE within 30ms
expect HMI.Alm.Jam FALSE

scenario M7 HMI: counters cleared on command; status tags cannot be written from the HMI
# Requirements: FS-21, FS-22, FS-24, FS-33
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 900
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
# P1 (plastic) reaches the entry station
set EntryPE TRUE
set EncCount 950
wait 100ms
set EncCount 1000
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 1000
scan
until HMI.Sts.CountPlastic 1 within 50ms
# delivery eyes count every part that arrives, tracked or not, in every state
set StopPB_NC FALSE
until ConveyorRun FALSE within 30ms
set StopPB_NC TRUE
set LaneA_PE TRUE
wait 100ms
set LaneA_PE FALSE
wait 100ms
set LaneB_PE TRUE
wait 100ms
set LaneB_PE FALSE
wait 100ms
set RejectPE TRUE
wait 100ms
set RejectPE FALSE
wait 100ms
expect HMI.Sts.CountLaneA 1
expect HMI.Sts.CountLaneB 1
expect HMI.Sts.CountReject 1
expect HMI.Sts.PartsInTransit 1   # FS-22: a lane eye only confirms a part that was pushed
# stray HMI writes into status tags are overwritten on the next scan
set HMI.Sts.State 3
set HMI.Sts.CountLaneA 99
set HMI.Sts.Ready FALSE
set HMI.Alm.Jam TRUE
wait 50ms
expect HMI.Sts.State 1
expect HMI.Sts.CountLaneA 1
expect HMI.Sts.Ready TRUE
expect HMI.Alm.Jam FALSE
expect ConveyorRun FALSE
set HMI.Cmd.ClearCounts TRUE
scan
expect HMI.Cmd.ClearCounts FALSE
wait 50ms
expect HMI.Sts.CountMetal 0
expect HMI.Sts.CountPlastic 0
expect HMI.Sts.CountOversize 0
expect HMI.Sts.CountLaneA 0
expect HMI.Sts.CountLaneB 0
expect HMI.Sts.CountReject 0
expect HMI.Sts.PartsInTransit 1   # clearing counters does not clear the tracking


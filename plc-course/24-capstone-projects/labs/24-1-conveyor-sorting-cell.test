scenario M4 the encoder count wraps from 65535 to 0 without upsetting the tracking
# Requirements: FS-14
# P1 (metal) registers at 65300, so pusher A acts at 65800 = 264 after the wrap.
# P2 (plastic) registers at 65500, so pusher B acts at 66500 = 964.
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE
set PusherA_RetLS TRUE
set PusherB_RetLS TRUE
set EncCount 65000
wait 100ms
# start the cell: press Start, 3 s warning, belt runs
set StartPB TRUE
scan
set StartPB FALSE
until ConveyorRun TRUE within 3500ms
set EncCount 65100
wait 200ms
set EncCount 65200
wait 200ms
# P1 (metal) reaches the entry station
set MetalPX TRUE
set EntryPE TRUE
set EncCount 65250
wait 100ms
set EncCount 65300
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 65300
scan
set MetalPX FALSE
set EncCount 65400
wait 200ms
# P2 (plastic) reaches the entry station
set EntryPE TRUE
set EncCount 65450
wait 100ms
set EncCount 65500
wait 100ms
set EntryPE FALSE   # trailing edge clears the eye: registered at 65500
scan
set EncCount 64
wait 200ms
set EncCount 164
wait 200ms
set EncCount 254
wait 180ms
wait 50ms
expect PusherA_Sol FALSE   # 10 mm short of the gate: not yet
set EncCount 264
until PusherA_Sol TRUE within 50ms   # at the gate: push
set PusherA_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherA_Sol TRUE   # still energised until the extended switch is made
set PusherA_ExtLS TRUE   # fully extended
until PusherA_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherA_ExtLS FALSE
wait 100ms
set PusherA_RetLS TRUE   # back home
wait 100ms
set LaneA_PE TRUE   # the part slides past the lane A delivery eye
wait 100ms
set LaneA_PE FALSE
scan
set EncCount 364
wait 200ms
set EncCount 464
wait 200ms
set EncCount 564
wait 200ms
set EncCount 664
wait 200ms
set EncCount 764
wait 200ms
set EncCount 864
wait 200ms
set EncCount 954
wait 180ms
wait 50ms
expect PusherB_Sol FALSE   # 10 mm short of the gate: not yet
set EncCount 964
until PusherB_Sol TRUE within 50ms   # at the gate: push
set PusherB_RetLS FALSE   # cylinder leaves home
wait 100ms
expect PusherB_Sol TRUE   # still energised until the extended switch is made
set PusherB_ExtLS TRUE   # fully extended
until PusherB_Sol FALSE within 50ms   # stroke complete: solenoid released
set PusherB_ExtLS FALSE
wait 100ms
set PusherB_RetLS TRUE   # back home
wait 100ms
set LaneB_PE TRUE   # the part slides past the lane B delivery eye
wait 100ms
set LaneB_PE FALSE
scan
until HMI.Sts.PartsInTransit 0 within 50ms
expect HMI.Sts.CountLaneA 1
expect HMI.Sts.CountLaneB 1
expect HMI.Alm.EStop FALSE
expect HMI.Alm.MotorOverload FALSE
expect HMI.Alm.EntryJam FALSE
expect HMI.Alm.Jam FALSE
expect HMI.Alm.PusherA FALSE
expect HMI.Alm.PusherB FALSE
expect HMI.Alm.TrackOverflow FALSE

scenario M4 lane A full: metal parts go to reject, amber lamp on, the belt keeps running
# Requirements: FS-15, FS-23, FS-26
set StopPB_NC TRUE
set EStop_NC TRUE
set MotorOL_NC TRUE
set ModeAuto TRUE

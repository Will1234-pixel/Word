wait 1s
set PT301 4.30
set FT302 51.0
wait 1s
set PT301 4.20
set FT302 50.0
wait 1s
set PT301 4.30
set FT302 51.0
wait 1s
set PT301 4.20
set FT302 50.0
wait 1s
set PT301 4.30
set FT302 51.0
wait 1s
expect PT301Chk.Frozen FALSE
expect FT302Chk.Frozen FALSE
expect FrozenAlm FALSE


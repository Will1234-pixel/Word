# Lab 16-3 acceptance tests: FB_FrozenSignal, FB_Heartbeat and the PLC's own heartbeat.
# Instances, set up by the program:
#   PT301Chk   PV PT301 (bar)    tolerance 0.05  freeze time 10 s  enabled while PumpRunFb
#   FT302Chk   PV FT302 (m3/h)   tolerance 0.5   freeze time 20 s  enabled while PumpRunFb
#   PartnerMon counter PartnerHB timeout 3 s
#   ScadaMon   counter ScadaHB   timeout 10 s
# The tests write PT301, FT302, PartnerHB and ScadaHB directly. In the
# frozen-signal scenarios the heartbeats are not exercised, and in the
# heartbeat scenarios the pump is stopped. Timing checks sit at about 90 %
# and 110 % of each time.

scenario no frozen alarm while the pump is stopped, however steady the values
set PumpRunFb FALSE
set PT301 4.20
set FT302 50.0
scan
wait 30s
expect PT301Chk.Frozen FALSE
expect FT302Chk.Frozen FALSE
expect FrozenAlm FALSE

scenario a dead-steady value while the pump runs is frozen after the freeze time
set PumpRunFb FALSE
set PT301 4.20
set FT302 50.0
scan
wait 5s                            # stopped for a while first: that time does not count
set PumpRunFb TRUE
wait 9s
expect PT301Chk.Frozen FALSE
wait 2s                            # 11 s since the pump started
expect PT301Chk.Frozen TRUE
expect FrozenAlm TRUE
expect FT302Chk.Frozen FALSE       # the flow check has its own, longer time
wait 7s                            # 18 s
expect FT302Chk.Frozen FALSE
wait 4s                            # 22 s
expect FT302Chk.Frozen TRUE

scenario movement smaller than the tolerance does not count as movement
set PumpRunFb FALSE
set PT301 4.20
set FT302 50.0
scan
set PumpRunFb TRUE
set PT301 4.23
wait 500ms
set PT301 4.20
wait 500ms
set PT301 4.23
wait 500ms
set PT301 4.20
wait 500ms
set PT301 4.23
wait 500ms
set PT301 4.20
wait 500ms
set PT301 4.23
wait 500ms
set PT301 4.20
wait 500ms
set PT301 4.23
wait 500ms
set PT301 4.20
wait 500ms
set PT301 4.23
wait 500ms
wait 4s                            # 9.5 s: 0.03 bar of ripple, tolerance 0.05
expect PT301Chk.Frozen FALSE
wait 1500ms                        # 11 s
expect PT301Chk.Frozen TRUE

